    "prisma": "^6.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-infinite-scroll-component": "^6.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^5.29.5",
    "swr": "^2.3.6"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
